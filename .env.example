# Portless local-dev hostnames
# Apps are reachable at https://<sub>.${PORTLESS_PROJECT}.${PORTLESS_TLD}
# e.g. https://api.viteplusmono.test, https://web.viteplusmono.test, https://admin.viteplusmono.test
PORTLESS_PROJECT=viteplusmono
PORTLESS_TLD=test
# Auto-sync /etc/hosts (Windows: hosts file). Requires admin/sudo on first run.
PORTLESS_SYNC_HOSTS=1
