{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "$/*": ["./*"],
      "$models": ["./src/db/models/index.ts"],
      "*": ["./src/*", "./*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
