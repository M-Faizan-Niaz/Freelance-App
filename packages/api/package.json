{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "openapi:export": "tsx --env-file=.env scripts/export-openapi.ts",
    "build": "tsup src/index.ts --format esm --dts --tsconfig tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "tsx src/db/drop.ts",
    "db:seed": "cross-env DB_SEEDING=true tsx src/db/seed.ts",
    "db:setup": "pnpm db:drop && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "db:up": "sudo docker-compose up -d"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@hono/node-server": "^1.19.12",
    "@hono/zod-openapi": "^1.2.4",
    "@hono/zod-validator": "^0.7.5",
    "@scalar/hono-api-reference": "^0.10.6",
    "better-auth": "^1.6.0",
    "dotenv": "^17.4.1",
    "dotenv-expand": "^12.0.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-seed": "^0.3.1",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.9.7",
    "hono-pino": "^0.10.3",
    "nodemailer": "^8.0.4",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.7",
    "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.19",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/nodemailer": "^8.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.4",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2"
  }
}
